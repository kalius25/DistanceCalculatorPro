QWidget {
    background: #171a21;
    color: #e6eaf0;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10pt;
}
QMainWindow {
    background: #11141a;
}
QMenuBar, QMenu, QToolBar, QStatusBar {
    background: #20242c;
}
QMenuBar {
    border-bottom: 1px solid #343a46;
}
QMenuBar::item {
    padding: 6px 10px;
    background: transparent;
}
QMenuBar::item:selected, QMenu::item:selected {
    background: #303a4b;
    color: #9ec5ff;
}
QMenu {
    border: 1px solid #3a414e;
    padding: 6px;
}
QMenu::item {
    padding: 7px 28px 7px 10px;
    border-radius: 5px;
}
QListWidget#lstNavigation {
    background: #20242c;
    border: 0;
    border-right: 1px solid #343a46;
    padding: 10px 8px;
    outline: 0;
}
QListWidget#lstNavigation::item {
    min-height: 42px;
    padding: 0 12px;
    margin: 2px 0;
    border-radius: 7px;
}
QListWidget#lstNavigation::item:hover {
    background: #292e38;
}
QListWidget#lstNavigation::item:selected {
    background: #303d55;
    color: #9ec5ff;
    font-weight: 600;
}
QLabel#lblPageTitle {
    font-size: 20pt;
    font-weight: 650;
    color: #f3f5f8;
}
QLabel#lblPageDescription {
    color: #a7b0bf;
    font-size: 10.5pt;
}
QToolBar {
    border: 0;
    border-bottom: 1px solid #343a46;
    spacing: 5px;
    padding: 6px 10px;
}
QToolBar QToolButton {
    background: transparent;
    border: 0;
    border-radius: 6px;
    padding: 6px;
}
QToolBar QToolButton:hover {
    background: #303640;
}
QToolBar QToolButton:pressed {
    background: #3a4250;
}
QStatusBar {
    border-top: 1px solid #343a46;
    color: #a7b0bf;
}
QStatusBar QLabel {
    background: transparent;
    padding: 0 8px;
}
QStatusBar QLabel#lblProvider,
QStatusBar QLabel#lblTheme,
QStatusBar QLabel#lblVersion {
    border-left: 1px solid #3a414e;
}
QDialog {
    background: #20242c;
}
QLabel#lblAboutMark {
    min-width: 72px;
    max-width: 72px;
    min-height: 72px;
    max-height: 72px;
    border-radius: 18px;
    background: #3b82f6;
    color: #ffffff;
    font-size: 18pt;
    font-weight: 700;
}
QLabel#lblAboutTitle {
    font-size: 20pt;
    font-weight: 700;
}
QLabel#lblAboutVersion,
QLabel#lblAboutRelease,
QLabel#lblAboutDescription {
    color: #a7b0bf;
}
QFrame#frmAboutSeparator {
    color: #3a414e;
}
QPushButton {
    min-width: 84px;
    min-height: 30px;
    padding: 4px 14px;
    border: 1px solid #4a5261;
    border-radius: 6px;
    background: #292e38;
    color: #e6eaf0;
}
QPushButton:hover {
    background: #343b47;
}
QToolTip {
    background: #f3f5f8;
    color: #171a21;
    border: 0;
    padding: 5px;
}
