QWidget {
    background: #f4f7fb;
    color: #172033;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10pt;
}
QMainWindow {
    background: #edf2f8;
}
QMenuBar, QMenu, QToolBar, QStatusBar {
    background: #ffffff;
}
QMenuBar {
    border-bottom: 1px solid #dbe3ee;
}
QMenuBar::item {
    padding: 6px 10px;
    background: transparent;
}
QMenuBar::item:selected, QMenu::item:selected {
    background: #e8f0fe;
    color: #174ea6;
}
QMenu {
    border: 1px solid #dbe3ee;
    padding: 6px;
}
QMenu::item {
    padding: 7px 28px 7px 10px;
    border-radius: 5px;
}
QListWidget#lstNavigation {
    background: #ffffff;
    border: 0;
    border-right: 1px solid #dbe3ee;
    padding: 10px 8px;
    outline: 0;
}
QListWidget#lstNavigation::item {
    min-height: 42px;
    padding: 0 12px;
    margin: 2px 0;
    border-radius: 7px;
}
QListWidget#lstNavigation::item:hover {
    background: #f1f5fb;
}
QListWidget#lstNavigation::item:selected {
    background: #e7f0ff;
    color: #0b57d0;
    font-weight: 600;
}
QLabel#lblPageTitle {
    font-size: 20pt;
    font-weight: 650;
    color: #172033;
}
QLabel#lblPageDescription {
    color: #667085;
    font-size: 10.5pt;
}
QToolBar {
    border: 0;
    border-bottom: 1px solid #dbe3ee;
    spacing: 5px;
    padding: 6px 10px;
}
QToolBar QToolButton {
    background: transparent;
    border: 0;
    border-radius: 6px;
    padding: 6px;
}
QToolBar QToolButton:hover {
    background: #edf3fc;
}
QToolBar QToolButton:pressed {
    background: #dfe9f8;
}
QStatusBar {
    border-top: 1px solid #dbe3ee;
    color: #526074;
}
QStatusBar QLabel {
    background: transparent;
    padding: 0 8px;
}
QStatusBar QLabel#lblProvider,
QStatusBar QLabel#lblTheme,
QStatusBar QLabel#lblVersion {
    border-left: 1px solid #e1e7ef;
}
QDialog {
    background: #ffffff;
}
QLabel#lblAboutMark {
    min-width: 72px;
    max-width: 72px;
    min-height: 72px;
    max-height: 72px;
    border-radius: 18px;
    background: #2563eb;
    color: #ffffff;
    font-size: 18pt;
    font-weight: 700;
}
QLabel#lblAboutTitle {
    font-size: 20pt;
    font-weight: 700;
}
QLabel#lblAboutVersion,
QLabel#lblAboutRelease,
QLabel#lblAboutDescription {
    color: #667085;
}
QFrame#frmAboutSeparator {
    color: #e1e7ef;
}
QPushButton {
    min-width: 84px;
    min-height: 30px;
    padding: 4px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #ffffff;
}
QPushButton:hover {
    background: #f1f5f9;
}
QToolTip {
    background: #172033;
    color: #ffffff;
    border: 0;
    padding: 5px;
}
